# Plantilla. Copia a .env y completa. NUNCA subir .env.
# Paso a paso: docs/GUIA-DESPLIEGUE.md

# GitHub: cuenta y repositorio donde vive el proyecto
GITHUB_OWNER=
GITHUB_REPO=
# Token de grano fino solo para ese repositorio (Contents: Read and write)
GITHUB_TOKEN=

# Cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Lo que va antes de .workers.dev (Workers & Pages > Subdominio)
CLOUDFLARE_SUBDOMINIO=
# Opcionales: nombre del Worker y del almacenamiento de comprobantes
WORKER_NOMBRE=sorteos-web3
R2_BUCKET=

# WalletConnect (publico; dashboard.reown.com)
WALLETCONNECT_PROJECT_ID=

# Pinata (opcional: copia de la web en IPFS)
PINATA_JWT=
