# =========================================================================
# Node / Next.js
# =========================================================================
node_modules/
.next/
out/
dist/
*.log
npm-debug.log*

# =========================================================================
# Android / Gradle
# =========================================================================
.gradle/
# Android: vale para los tres modulos (cliente, admin y vendedor). Antes solo
# se ignoraba apps/android/, asi que la salida de compilacion de los modulos
# nuevos se habria commiteado.
apps/*/build/
apps/*/app/build/
apps/*/local.properties
apps/android/.idea/
*.apk
*.aab

# =========================================================================
# Rust / Tauri
# =========================================================================
apps/admin-windows/src-tauri/target/
apps/admin-windows/src-tauri/gen/schemas/
*.msi

# =========================================================================
# Python
# =========================================================================
__pycache__/
*.pyc

# =========================================================================
# Secretos / firmas (NUNCA en el repo)
# =========================================================================
.env
.env.local
.env.*.local
*.keystore
*.jks
*.pem
credentials.json
token.json

# =========================================================================
# Sistema operativo / editores
# =========================================================================
.DS_Store
Thumbs.db
.vscode/

# Build de la web
apps/web/.next/
apps/web/out/

# APK admin: la UI se copia de apps/admin-windows/src en cada build (fuente unica)
apps/admin-android/app/src/main/assets/
apps/seller-android/app/src/main/assets/

# Salida de compilar-apks.bat (binarios locales)
/dist/

# =========================================================================
# Plantilla del espacio de trabajo (CLAUDE.md v8) + secretos locales
# =========================================================================
.secrets/
**/.secrets/
*.pfx
.tmp/
graphify-out/
.codegraph/
*.v7-bak-*
*.bak-*
# Variables locales con secretos (DATABASE_URL, clave del admin): NUNCA al repo.
.env.local
*.env.local
.env.*.local

